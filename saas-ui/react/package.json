{
  "name": "@saas-ui-pro/react",
  "version": "0.36.4",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./theme": {
      "source": "./src/theme/index.ts",
      "require": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.mjs"
    },
    "./src": {
      "default": "./src/index.ts"
    },
    "./src/theme": {
      "default": "./src/theme/index.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts",
        "dist/theme/index.d.ts",
        "src/index.ts"
      ]
    },
    "./theme": {
      "*": [
        "dist/theme/index.d.ts",
        "src/index.ts"
      ]
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.saas-ui.dev"
  },
  "scripts": {
    "bundle": "yarn pack --out ../dist/%s-%v.tgz",
    "build": "tsup src/index.ts src/theme/index.ts --config tsup.config.ts",
    "lint": "TIMING=1 eslint src/**/*.ts* --fix",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/saas-js/saas-ui-pro.git",
    "directory": "saas-ui/pro"
  },
  "dependencies": {
    "@chakra-ui/anatomy": "^2.3.4",
    "@chakra-ui/clickable": "^2.1.0",
    "@chakra-ui/react-utils": "^2.0.12",
    "@chakra-ui/styled-system": "^2.11.1",
    "@chakra-ui/theme-tools": "^2.2.5",
    "@chakra-ui/utils": "^2.2.1",
    "@react-hookz/web": "^24.0.4",
    "@saas-ui-pro/onboarding": "workspace:*",
    "@saas-ui/forms": "^2.7.1",
    "@saas-ui/react-utils": "^2.1.1",
    "@saas-ui/theme": "^2.5.1",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "@zag-js/dom-utils": "^0.2.4",
    "date-fns": "^4.1.0",
    "polished": "^4.3.1"
  },
  "peerDependencies": {
    "@chakra-ui/react": ">=2.5.0",
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@saas-ui/react": ">=2.0.0",
    "framer-motion": ">=5.5.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@ngneat/falso": "^7.2.0",
    "@saas-ui/date-picker": "^0.13.1",
    "react-icons": "^5.3.0",
    "tsup": "^8.3.0"
  }
}
